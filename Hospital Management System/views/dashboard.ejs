
<!DOCTYPE html>
<html>
<head>
<title>Dashboard</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
body{
background:url('https://images.unsplash.com/photo-1586773860418-d37222d8fce3') no-repeat center center/cover;
min-height:100vh;
color:white;
}
.sidebar{
height:100vh;
background:rgba(0,0,0,0.85);
padding:20px;
position:fixed;
width:220px;
}
.content{
margin-left:240px;
padding:40px;
}
.card{
background:rgba(255,255,255,0.95);
color:black;
border-radius:15px;
}
</style>

</head>
<body>
<div class="sidebar">
<h4>🏥 Menu</h4>
<a href="/dashboard" class="text-white d-block">Dashboard</a>
<a href="/appointment" class="text-white d-block">Book</a>
<a href="/history" class="text-white d-block">History</a>
<a href="/doctors" class="text-white d-block">Doctors</a>
</div>

<div class="content">
<h2>Dashboard</h2>

<div class="row">
<div class="col-md-4">
<div class="card p-3">
<h5>Total Patients</h5>
<h3><%= patients.length %></h3>
</div>
</div>
<div class="col-md-4">
<div class="card p-3">
<h5>Total Revenue</h5>
<h3>₹<%= revenue %></h3>
</div>
</div>
</div>

<div class="card p-4 mt-4">
<canvas id="chart"></canvas>
</div>

<script>
const ctx = document.getElementById('chart');
new Chart(ctx, {
type: 'pie',
data: {
labels: ['Fever','Diabetes','Cold','Headache'],
datasets: [{
data: [12,19,7,5]
}]
}
});
</script>

</div>
</body>
</html>
