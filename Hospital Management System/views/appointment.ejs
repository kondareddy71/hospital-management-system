
<!DOCTYPE html>
<html>
<head>
<title>Appointment</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body{
background:url('https://images.unsplash.com/photo-1586773860418-d37222d8fce3') no-repeat center center/cover;
min-height:100vh;
color:white;
}
.sidebar{
height:100vh;
background:rgba(0,0,0,0.85);
padding:20px;
position:fixed;
width:220px;
}
.content{
margin-left:240px;
padding:40px;
}
.card{
background:rgba(255,255,255,0.95);
color:black;
border-radius:15px;
}
</style>

</head>
<body>
<div class="content">
<div class="card p-4">
<h3>Book Appointment</h3>
<form method="POST">
<input name="name" class="form-control mb-2" placeholder="Patient Name" required>
<select name="doctor" class="form-select mb-2">
<% doctors.forEach(function(d){ %>
<option><%= d.name %> - <%= d.specialization %></option>
<% }) %>
</select>
<select name="disease" class="form-select mb-2">
<option>Fever</option>
<option>Diabetes</option>
<option>Cold</option>
<option>Headache</option>
</select>
<button class="btn btn-success w-100">Submit</button>
</form>
</div>
</div>
</body>
</html>
