<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ABHA Registration - Universal Health Coverage</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        
        .container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            max-width: 500px;
            width: 100%;
            padding: 40px;
        }
        
        .header {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .logo {
            font-size: 32px;
            margin-bottom: 10px;
        }
        
        h1 {
            color: #333;
            font-size: 28px;
            margin-bottom: 10px;
        }
        
        .subtitle {
            color: #667eea;
            font-size: 14px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .badge {
            display: inline-block;
            background: #e3f2fd;
            color: #1976d2;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            margin-top: 10px;
        }
        
        .info-box {
            background: #f5f5f5;
            border-left: 4px solid #667eea;
            padding: 15px;
            margin-bottom: 25px;
            border-radius: 5px;
            font-size: 13px;
            color: #555;
            line-height: 1.6;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        label {
            display: block;
            color: #333;
            font-weight: 600;
            margin-bottom: 8px;
            font-size: 14px;
        }
        
        input[type="text"],
        input[type="email"],
        input[type="tel"] {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            transition: border-color 0.3s;
        }
        
        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="tel"]:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        
        .form-help {
            font-size: 12px;
            color: #999;
            margin-top: 5px;
        }
        
        button {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            margin-top: 10px;
        }
        
        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }
        
        button:active {
            transform: translateY(0);
        }
        
        #response {
            margin-top: 20px;
            padding: 15px;
            border-radius: 8px;
            display: none;
            text-align: center;
        }
        
        #response.success {
            background: #c8e6c9;
            color: #2e7d32;
            border: 2px solid #43a047;
            display: block;
        }
        
        #response.error {
            background: #ffcdd2;
            color: #c62828;
            border: 2px solid #ef5350;
            display: block;
        }
        
        .abha-id-display {
            background: #fff3cd;
            border: 2px solid #ffc107;
            border-radius: 8px;
            padding: 15px;
            margin-top: 15px;
            text-align: center;
            display: none;
        }
        
        .abha-id-display.show {
            display: block;
        }
        
        .abha-id-label {
            font-size: 12px;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
        }
        
        .abha-id-value {
            font-size: 24px;
            font-weight: bold;
            color: #f57f17;
            font-family: 'Courier New', monospace;
            margin: 10px 0;
            letter-spacing: 2px;
        }
        
        .abha-benefits {
            background: #e8f5e9;
            padding: 15px;
            border-radius: 8px;
            margin-top: 20px;
            border-left: 4px solid #4caf50;
        }
        
        .abha-benefits h3 {
            color: #2e7d32;
            font-size: 14px;
            margin-bottom: 10px;
        }
        
        .abha-benefits ul {
            list-style: none;
            font-size: 13px;
            color: #555;
        }
        
        .abha-benefits li {
            padding: 5px 0;
            padding-left: 20px;
            position: relative;
        }
        
        .abha-benefits li:before {
            content: "✓";
            position: absolute;
            left: 0;
            color: #4caf50;
            font-weight: bold;
        }
        
        .back-link {
            text-align: center;
            margin-top: 20px;
        }
        
        .back-link a {
            color: #667eea;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
        }
        
        .back-link a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="logo">🏥</div>
            <h1>ABHA Account</h1>
            <p class="subtitle">Ayushman Bharat Health Account</p>
            <span class="badge">Universal Health Coverage</span>
        </div>
        
        <div class="info-box">
            <strong>📋 What is ABHA?</strong><br>
            ABHA (Ayushman Bharat Health Account) enables nationwide portability of your health records. Your medical history follows you across any hospital, clinic, or pharmacy in India.
        </div>
        
        <form id="abhaForm">
            <div class="form-group">
                <label for="name">Full Name *</label>
                <input type="text" id="name" name="name" placeholder="Enter your full name" required>
            </div>
            
            <div class="form-group">
                <label for="phone">Phone Number *</label>
                <input type="tel" id="phone" name="phone" placeholder="10-digit mobile number" maxlength="10" required>
                <p class="form-help">Will be used for OTP verification</p>
            </div>
            
            <div class="form-group">
                <label for="aadhar">Aadhar Number *</label>
                <input type="text" id="aadhar" name="aadhar" placeholder="12-digit Aadhar number" maxlength="12" required>
                <p class="form-help">Unique identifier for ABHA creation</p>
            </div>
            
            <button type="submit">Create ABHA ID</button>
        </form>
        
        <div id="response"></div>
        
        <div id="abhaIdDisplay" class="abha-id-display">
            <div class="abha-id-label">Your ABHA ID</div>
            <div class="abha-id-value" id="abhaIdValue"></div>
            <p style="font-size: 12px; color: #666; margin-top: 10px;">
                Save this ID. You can use it across all healthcare providers.
            </p>
        </div>
        
        <div class="abha-benefits">
            <h3>✨ Benefits of ABHA:</h3>
            <ul>
                <li>Access health records anywhere in India</li>
                <li>Emergency medical history available instantly</li>
                <li>No need for paper prescriptions</li>
                <li>Safe, encrypted health data</li>
                <li>Control who can access your data</li>
            </ul>
        </div>
        
        <div class="back-link">
            <a href="/">← Back to Home</a>
        </div>
    </div>
    
    <script>
        document.getElementById('abhaForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const name = document.getElementById('name').value;
            const phone = document.getElementById('phone').value;
            const aadhar = document.getElementById('aadhar').value;
            
            if (phone.length !== 10) {
                showResponse('Phone number must be 10 digits', 'error');
                return;
            }
            
            if (aadhar.length !== 12) {
                showResponse('Aadhar number must be 12 digits', 'error');
                return;
            }
            
            try {
                const response = await fetch('/abha-register', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ name, phone, aadhar })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    showResponse(data.message, 'success');
                    document.getElementById('abhaIdValue').textContent = data.abhaId;
                    document.getElementById('abhaIdDisplay').classList.add('show');
                    document.getElementById('abhaForm').reset();
                    
                    // Store in localStorage
                    localStorage.setItem('abhaId', data.abhaId);
                    localStorage.setItem('abhaUser', JSON.stringify(data.details));
                } else {
                    showResponse(data.message || 'Error creating ABHA account', 'error');
                }
            } catch (error) {
                showResponse('Error: ' + error.message, 'error');
            }
        });
        
        function showResponse(message, type) {
            const response = document.getElementById('response');
            response.textContent = message;
            response.className = type;
        }
    </script>
</body>
</html>
