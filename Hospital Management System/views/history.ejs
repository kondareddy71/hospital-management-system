
<!DOCTYPE html>
<html>
<head>
<title>History</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body{
background:url('https://images.unsplash.com/photo-1586773860418-d37222d8fce3') no-repeat center center/cover;
min-height:100vh;
color:white;
}
.sidebar{
height:100vh;
background:rgba(0,0,0,0.85);
padding:20px;
position:fixed;
width:220px;
}
.content{
margin-left:240px;
padding:40px;
}
.card{
background:rgba(255,255,255,0.95);
color:black;
border-radius:15px;
}
</style>

</head>
<body>
<div class="content">
<h3>Patient History</h3>
<div class="card p-3">
<table class="table">
<tr><th>ID</th><th>Name</th><th>Disease</th><th>Bill</th><th>PDF</th></tr>
<% patients.forEach(function(p){ %>
<tr>
<td><%= p.id %></td>
<td><%= p.name %></td>
<td><%= p.disease %></td>
<td>₹<%= p.total %></td>
<td><a href="/bill/<%= p.id %>" class="btn btn-sm btn-primary">Download</a></td>
</tr>
<% }) %>
</table>
</div>
</div>
</body>
</html>
